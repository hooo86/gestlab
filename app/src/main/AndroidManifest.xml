<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-permission android:name="android.permission.INTERNET" />

    <!-- Permissions de l'application OpenVPN complète, inutiles ici et refusées
         par Google Play sans justification : retirées. -->
    <uses-permission android:name="android.permission.QUERY_ALL_PACKAGES" tools:node="remove" />
    <uses-permission android:name="android.permission.READ_EXTERNAL_STORAGE" tools:node="remove" />
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" tools:node="remove" />

    <application
        android:name=".GestlabApp"
        android:allowBackup="false"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:networkSecurityConfig="@xml/network_security_config"
        android:supportsRtl="true"
        android:theme="@style/Theme.Gestlab"
        tools:replace="android:name,android:allowBackup,android:icon,android:roundIcon,android:label,android:theme">

        <!-- Doit s'appeler <package>.activities.MainActivity : la notification du VPN l'ouvre. -->
        <activity
            android:name=".activities.MainActivity"
            android:configChanges="orientation|screenSize|screenLayout|smallestScreenSize|keyboardHidden"
            android:exported="true"
            android:launchMode="singleTask"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <activity
            android:name=".activities.LoginActivity"
            android:exported="false"
            android:windowSoftInputMode="adjustResize" />

        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.files"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>

        <!-- ===== Sécurité : composants d'ics-openvpn retirés ou rendus privés =====
             Sans cela, n'importe quelle autre application du téléphone pourrait
             piloter le VPN de Gestlab (API externe d'OpenVPN pour Android). -->
        <meta-data android:name="android.content.APP_RESTRICTIONS" tools:node="remove" />
        <service android:name="de.blinkt.openvpn.api.ExternalOpenVPNService" tools:node="remove" />
        <activity android:name="de.blinkt.openvpn.api.GrantPermissionsActivity" tools:node="remove" />
        <activity android:name="de.blinkt.openvpn.api.ConfirmDialog" tools:node="remove" />
        <activity android:name="de.blinkt.openvpn.api.RemoteAction" tools:node="remove" />
        <activity-alias android:name="de.blinkt.openvpn.api.ConnectVPN" tools:node="remove" />
        <activity-alias android:name="de.blinkt.openvpn.api.DisconnectVPN" tools:node="remove" />
        <activity-alias android:name="de.blinkt.openvpn.api.PauseVPN" tools:node="remove" />
        <activity-alias android:name="de.blinkt.openvpn.api.ResumeVPN" tools:node="remove" />
        <activity-alias android:name="de.blinkt.openvpn.api.SetDefaultVPN" tools:node="remove" />
        <receiver android:name="de.blinkt.openvpn.OnBootReceiver" tools:node="remove" />

        <activity
            android:name="de.blinkt.openvpn.LaunchVPN"
            android:exported="false"
            tools:replace="android:exported" />
        <activity
            android:name="de.blinkt.openvpn.activities.NotImplemented"
            android:exported="false"
            tools:replace="android:exported" />
        <activity-alias
            android:name="de.blinkt.openvpn.activities.LogWindow"
            android:exported="false"
            android:targetActivity="de.blinkt.openvpn.activities.NotImplemented"
            tools:replace="android:exported" />
        <activity-alias
            android:name="de.blinkt.openvpn.activities.Req"
            android:exported="false"
            android:targetActivity="de.blinkt.openvpn.activities.NotImplemented"
            tools:replace="android:exported" />
    </application>
</manifest>
